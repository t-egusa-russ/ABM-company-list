# Google Custom Search API設定
GOOGLE_API_KEY=your_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# --- 週次補助金レポート（毎週月曜12:00 JST）用 SMTP 設定 ---
# Gmail を使う場合は SMTP_USE_SSL=false のまま、STARTTLSで587ポートを使用。
# SMTP_PASSWORD は Gmail の場合「アプリパスワード」を発行して設定する。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_account@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_SSL=false
MAIL_FROM=your_smtp_account@example.com
MAIL_TO=recipient1@example.com,recipient2@example.com
